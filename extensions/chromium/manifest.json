{
  "manifest_version": 3,
  "name": "webcraft Integration Module",
  "version": "0.25.0",
  "description": "Send downloads to webcraft desktop app",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "downloads", "cookies", "tabs", "nativeMessaging", "webRequest", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["rank.js", "content.js"], "run_at": "document_start", "all_frames": true }],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "webcraft", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } }
}
