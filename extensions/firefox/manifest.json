{
  "manifest_version": 2,
  "name": "webcraft Integration Module",
  "version": "0.25.1",
  "description": "Send downloads to webcraft desktop app",
  "browser_specific_settings": { "gecko": { "id": "downloadcraft@downloadcraft.local", "strict_min_version": "140.0", "data_collection_permissions": { "required": ["browsingActivity", "websiteContent"] } } },
  "background": { "scripts": ["rank.js", "background.js"], "persistent": true },
  "permissions": ["contextMenus", "downloads", "cookies", "tabs", "nativeMessaging", "webRequest", "webRequestBlocking", "notifications", "<all_urls>", "storage"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["rank.js", "content.js"], "run_at": "document_start", "all_frames": true }],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_action": { "default_title": "webcraft", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } }
}
